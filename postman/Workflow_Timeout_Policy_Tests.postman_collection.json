        {
          "name": "Create Workflow Policy",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nightly Report Workflow\",\n  \"targetId\": \"workflow-nightly-report-001\",\n  \"teamId\": \"analytics-team\",\n  \"timeoutMinutes\": 90,\n  \"action\": \"ALERT_AND_KILL\",\n  \"alertChannels\": \"email,dingtalk\",\n  \"escalationMinutes\": 20,\n  \"escalationContacts\": \"analytics-lead@company.com\",\n  \"enabled\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/workflow-policies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workflow-policies"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Policy created with WORKFLOW level', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.level).to.equal('WORKFLOW');",
                  "    pm.expect(jsonData.name).to.equal('Nightly Report Workflow');",
                  "    pm.expect(jsonData.targetId).to.equal('workflow-nightly-report-001');",
                  "    pm.expect(jsonData.timeoutMinutes).to.equal(90);",
                  "    pm.expect(jsonData.action).to.equal('ALERT_AND_KILL');",
                  "    pm.expect(jsonData.id).to.not.be.empty;",
                  "    pm.collectionVariables.set('workflowPolicyId', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
